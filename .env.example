# CryptoAgg Environment Variables

# ===========================================
# AI Analysis Service (Required)
# ===========================================
# Option 1: Use Vercel AI Gateway (Recommended - free Gemini access)
# Get your API key from: https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=your-ai-gateway-api-key-here

# Option 2: Use Google Gemini API directly
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# Frontend API URL (for CORS)
# ===========================================
# VITE_API_URL=http://localhost:3001
